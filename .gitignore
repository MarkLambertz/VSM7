# Canonical workshop/project data stays local and is backed up separately.
VSM7-Workspaces/

# Keep GitHub documentation intentional. Markdown is local by default; only
# the two root-level product READMEs are transferred.
*.md
!/README.md
!/README-LINUX.md

# Generated documents and working archives stay local.
*.[pP][dD][fF]
*.[zZ][iI][pP]

# Local-only Step VI editor assets.
/channel-variety-check.html
/e2e-robustness-check.html

# Local-only design and agent workspaces.
/.claude/
/design-previews/

# Installed dependencies and generated test output.
node_modules/
**/node_modules/
test-results/
**/test-results/

# macOS and Python-generated files.
.DS_Store
**/.DS_Store
__pycache__/
**/__pycache__/
*.py[cod]

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local
